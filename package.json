{
  "name": "mobilidade",
  "version": "0.3.0",
  "private": true,
  "description": "Urban mobility platform monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @mobilidade/api",
    "dev:passenger": "npm run start --workspace @mobilidade/passenger",
    "dev:driver": "npm run start --workspace @mobilidade/driver",
    "build:api": "npm run build --workspace @mobilidade/api",
    "typecheck": "npm run typecheck --workspace @mobilidade/api",
    "typecheck:passenger": "npm run typecheck --workspace @mobilidade/passenger",
    "typecheck:driver": "npm run typecheck --workspace @mobilidade/driver",
    "db:generate": "npm run db:generate --workspace @mobilidade/database",
    "db:push": "npm run db:push --workspace @mobilidade/database",
    "db:seed-admin": "npm run db:seed-admin --workspace @mobilidade/api",
    "test:integration": "npm run test:integration --workspace @mobilidade/api",
    "build:passenger": "npm run build --workspace @mobilidade/passenger",
    "build:driver": "npm run build --workspace @mobilidade/driver"
  },
  "engines": {
    "node": ">=20"
  }
}
