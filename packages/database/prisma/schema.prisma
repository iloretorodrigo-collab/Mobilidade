generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PASSENGER
  DRIVER
  ADMIN
}

enum DriverApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationChannel {
  EMAIL
  PHONE
}

enum VerificationPurpose {
  VERIFY_EMAIL
  VERIFY_PHONE
  RESET_PASSWORD
}

enum RideStatus {
  REQUESTED
  ACCEPTED
  DRIVER_ARRIVING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  phone          String?        @unique
  passwordHash   String
  role           UserRole       @default(PASSENGER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  emailVerified  Boolean        @default(false)
  phoneVerified  Boolean        @default(false)
  verificationChallenges VerificationChallenge[]
  adminDriverDecisions DriverApprovalDecision[] @relation("AdminDriverDecisions")
  driverApprovalDecisions DriverApprovalDecision[] @relation("DriverApprovalDecisions")
  driverProfile  DriverProfile?
  passengerRides Ride[]         @relation("PassengerRides")
  driverRides    Ride[]         @relation("DriverRides")
}

model DriverProfile {
  id               String                @id @default(cuid())
  userId           String                @unique
  cpf              String?               @unique
  licenseNumber    String?               @unique
  vehicleMake      String?
  vehicleModel     String?
  vehicleColor     String?
  vehiclePlate     String?               @unique
  approvalStatus   DriverApprovalStatus  @default(PENDING)
  isOnline         Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Ride {
  id                   String     @id @default(cuid())
  passengerId          String
  driverId             String?
  status               RideStatus @default(REQUESTED)
  originLatitude       Float
  originLongitude      Float
  destinationLatitude  Float
  destinationLongitude Float
  estimatedFareCents   Int?
  finalFareCents       Int?
  requestedAt          DateTime   @default(now())
  acceptedAt           DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  passenger            User       @relation("PassengerRides", fields: [passengerId], references: [id])
  driver               User?      @relation("DriverRides", fields: [driverId], references: [id])

  @@index([passengerId, requestedAt])
  @@index([driverId, status])
  @@index([status, requestedAt])
}


model VerificationChallenge {
  id         String              @id @default(cuid())
  userId     String
  channel    VerificationChannel
  purpose    VerificationPurpose
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int                 @default(0)
  createdAt  DateTime            @default(now())
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, channel, createdAt])
  @@index([expiresAt])
}

model DriverApprovalDecision {
  id           String               @id @default(cuid())
  adminUserId  String
  driverUserId String
  status       DriverApprovalStatus
  reason       String?
  createdAt    DateTime             @default(now())
  admin        User                 @relation("AdminDriverDecisions", fields: [adminUserId], references: [id])
  driver       User                 @relation("DriverApprovalDecisions", fields: [driverUserId], references: [id])

  @@index([driverUserId, createdAt])
  @@index([adminUserId, createdAt])
}
