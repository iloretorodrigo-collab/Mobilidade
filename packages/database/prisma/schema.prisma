generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PASSENGER
  DRIVER
  ADMIN
}

enum DriverApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RideStatus {
  REQUESTED
  ACCEPTED
  DRIVER_ARRIVING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  phone          String?        @unique
  passwordHash   String
  role           UserRole       @default(PASSENGER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  driverProfile  DriverProfile?
  passengerRides Ride[]         @relation("PassengerRides")
  driverRides    Ride[]         @relation("DriverRides")
  tripQuotes     TripQuote[]
  driverOffers   DriverOffer[]
}

model DriverProfile {
  id               String                @id @default(cuid())
  userId           String                @unique
  cpf              String?               @unique
  licenseNumber    String?               @unique
  vehicleMake      String?
  vehicleModel     String?
  vehicleColor     String?
  vehiclePlate     String?               @unique
  approvalStatus   DriverApprovalStatus  @default(PENDING)
  isOnline         Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Ride {
  id                   String     @id @default(cuid())
  passengerId          String
  driverId             String?
  status               RideStatus @default(REQUESTED)
  originLatitude       Float
  originLongitude      Float
  destinationLatitude  Float
  destinationLongitude Float
  estimatedFareCents   Int?
  quoteId              String?    @unique
  idempotencyKey       String?    @unique
  quote                TripQuote? @relation(fields: [quoteId], references: [id])
  offers               DriverOffer[]
  finalFareCents       Int?
  requestedAt          DateTime   @default(now())
  acceptedAt           DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  passenger            User       @relation("PassengerRides", fields: [passengerId], references: [id])
  driver               User?      @relation("DriverRides", fields: [driverId], references: [id])

  @@index([passengerId, requestedAt])
  @@index([driverId, status])
  @@index([status, requestedAt])
}

model TripQuote {
  id                    String   @id @default(cuid())
  passengerId           String
  originLatitude        Float
  originLongitude       Float
  destinationLatitude   Float
  destinationLongitude  Float
  distanceMeters        Int
  durationSeconds       Int
  estimatedFareCents    Int
  fareRuleVersion       String   @default("mvp-v1")
  expiresAt             DateTime
  usedAt                DateTime?
  createdAt             DateTime @default(now())
  passenger             User     @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  ride                  Ride?

  @@index([passengerId, createdAt])
  @@index([expiresAt, usedAt])
}

model DriverOffer {
  id         String   @id @default(cuid())
  rideId     String
  driverId   String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime @default(now())
  ride       Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driver     User     @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([rideId, driverId])
  @@index([driverId, expiresAt])
  @@index([rideId, expiresAt])
}

model OutboxEvent {
  id            String   @id @default(cuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  attempts      Int      @default(0)
  createdAt     DateTime @default(now())
  publishedAt   DateTime?
  lastError     String?

  @@index([publishedAt, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
}
